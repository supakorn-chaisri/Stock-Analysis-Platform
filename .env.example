# Stock Analysis Platform - Environment Variables
# Copy to .env and fill in values (never commit .env)

# Database
POSTGRES_PASSWORD=changeme

# JWT (min 32 chars for HS256, use `openssl rand -base64 32`)
JWT_KEY=dev-secret-key-min-32-chars-long-change-in-production

# Data Providers
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
GEMINI_API_KEY=your_gemini_api_key_with_billing_here

# Email (SendGrid/Resend)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: Sentry
SENTRY_DSN=

# Optional: Grafana Cloud
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=